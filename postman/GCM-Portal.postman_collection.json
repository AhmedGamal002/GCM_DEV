{
  "info": {
    "name": "GCM Portal",
    "_postman_id": "b1e9d8b0-6f5a-4b0a-9c1a-gcmportal0001",
    "description": "GCM Portal API + Platform (Super Admin) collection. Covers everything shipped through Week 3 (Driver Management): Tenant Auth, Users, Roles (read-only), Profile, Drivers, and Platform (Tenants/Roles/Permissions CRUD).\n\nSee postman/README.md in the repo for how the two auth flows work (Bearer token for /api/v1/*, session+CSRF for /platform/*) and the convention to follow when adding a new endpoint's request here.\n\nKeep this file updated alongside the code: every new API/Platform route gets a request added here in the same PR/session that adds the route.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{tenant_token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "api_base", "value": "{{base_url}}/api/v1", "type": "string" },
    { "key": "tenant_email", "value": "admin@gcm.test", "type": "string" },
    { "key": "tenant_password", "value": "password", "type": "string" },
    { "key": "tenant_token", "value": "", "type": "string" },
    { "key": "platform_email", "value": "superadmin@product.test", "type": "string" },
    { "key": "platform_password", "value": "password", "type": "string" },
    { "key": "platform_csrf", "value": "", "type": "string" },
    { "key": "last_user_id", "value": "", "type": "string" },
    { "key": "last_driver_id", "value": "", "type": "string" },
    { "key": "last_tenant_id", "value": "", "type": "string" },
    { "key": "last_role_id", "value": "", "type": "string" },
    { "key": "last_permission_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Auth (Tenant)",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tenant_email}}\",\n  \"password\": \"{{tenant_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{api_base}}/auth/login",
              "host": ["{{api_base}}"],
              "path": ["auth", "login"]
            },
            "description": "Postman is never a SANCTUM_STATEFUL_DOMAINS origin, so this always returns a bearer `token` (the same path a future mobile app would use) instead of a session cookie. The test script below saves it into {{tenant_token}}, which every other request in this collection sends via the collection-level Bearer auth."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', () => pm.response.code === 200);",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.token) {",
                  "        pm.collectionVariables.set('tenant_token', body.token);",
                  "        console.log('tenant_token saved');",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{api_base}}/auth/logout",
              "host": ["{{api_base}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tenant_email}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{api_base}}/auth/forgot-password",
              "host": ["{{api_base}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"paste-token-from-email-log-here\",\n  \"email\": \"{{tenant_email}}\",\n  \"password\": \"NewPassword123!\",\n  \"password_confirmation\": \"NewPassword123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{api_base}}/auth/reset-password",
              "host": ["{{api_base}}"],
              "path": ["auth", "reset-password"]
            },
            "description": "In local dev, MAIL_MAILER=log — grab the reset token from storage/logs/laravel.log."
          }
        }
      ]
    },
    {
      "name": "2. Me / Profile",
      "item": [
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{api_base}}/me", "host": ["{{api_base}}"], "path": ["me"] }
          }
        },
        {
          "name": "Update Profile (Name)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{api_base}}/me", "host": ["{{api_base}}"], "path": ["me"] },
            "description": "Email is immutable — not part of this payload. See ARCHITECTURE.md for why."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{tenant_password}}\",\n  \"new_password\": \"NewPassword123!\",\n  \"new_password_confirmation\": \"NewPassword123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{api_base}}/me/password", "host": ["{{api_base}}"], "path": ["me", "password"] }
          }
        }
      ]
    },
    {
      "name": "3. Roles (Read-only, Tenant)",
      "item": [
        {
          "name": "List Roles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{api_base}}/roles", "host": ["{{api_base}}"], "path": ["roles"] },
            "description": "Available to every tenant role (e.g. for a role-assignment dropdown). No mutation route exists here — Role/Permission CRUD lives entirely under Platform (Super Admin), see folder 7-8."
          }
        }
      ]
    },
    {
      "name": "4. Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{api_base}}/users?per_page=15",
              "host": ["{{api_base}}"],
              "path": ["users"],
              "query": [
                { "key": "per_page", "value": "15" },
                { "key": "status", "value": "active", "disabled": true, "description": "active | on_vacation | deactivated" },
                { "key": "role", "value": "data_entry", "disabled": true, "description": "data_entry | auditor | driver | system_admin" },
                { "key": "search", "value": "ahmed", "disabled": true, "description": "matches name or email" }
              ]
            },
            "description": "system_admin only (UserPolicy::viewAny). Excludes the caller's own row — self is edited via /me."
          }
        },
        {
          "name": "Export Users (Excel)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base}}/users/export?format=xlsx",
              "host": ["{{api_base}}"],
              "path": ["users", "export"],
              "query": [{ "key": "format", "value": "xlsx" }]
            }
          }
        },
        {
          "name": "Export Users (PDF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base}}/users/export?format=pdf",
              "host": ["{{api_base}}"],
              "path": ["users", "export"],
              "query": [{ "key": "format", "value": "pdf" }]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "New Data Entry User", "type": "text" },
                { "key": "email", "value": "new.user+{{$timestamp}}@gcm.test", "type": "text" },
                { "key": "phone", "value": "0100000{{$timestamp}}", "type": "text" },
                { "key": "photo", "type": "file", "src": [], "disabled": true },
                { "key": "password", "value": "Password123!", "type": "text" },
                { "key": "password_confirmation", "value": "Password123!", "type": "text" },
                { "key": "status", "value": "active", "type": "text" },
                { "key": "additional_data", "value": "", "type": "text", "disabled": true },
                { "key": "roles[]", "value": "data_entry", "type": "text", "description": "Exactly one of: data_entry | auditor | driver (system_admin is never creatable here)" }
              ]
            },
            "url": { "raw": "{{api_base}}/users", "host": ["{{api_base}}"], "path": ["users"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.data && body.data.id) {",
                  "        pm.collectionVariables.set('last_user_id', body.data.id);",
                  "        console.log('last_user_id saved:', body.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Show User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{api_base}}/users/{{last_user_id}}",
              "host": ["{{api_base}}"],
              "path": ["users", "{{last_user_id}}"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Updated Name", "type": "text" },
                { "key": "phone", "value": "0100000000", "type": "text" },
                { "key": "photo", "type": "file", "src": [], "disabled": true },
                { "key": "additional_data", "value": "", "type": "text", "disabled": true },
                { "key": "roles[]", "value": "auditor", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{api_base}}/users/{{last_user_id}}",
              "host": ["{{api_base}}"],
              "path": ["users", "{{last_user_id}}"]
            },
            "description": "Postman sends real multipart PATCH natively — no _method spoofing needed."
          }
        },
        {
          "name": "Update User Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"on_vacation\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{api_base}}/users/{{last_user_id}}/status",
              "host": ["{{api_base}}"],
              "path": ["users", "{{last_user_id}}", "status"]
            },
            "description": "status: active | on_vacation | deactivated. Deactivating a system_admin always fails (422) regardless of who asks — see CannotDeactivateSystemAdminException."
          }
        }
      ]
    },
    {
      "name": "5. Drivers",
      "item": [
        {
          "name": "List Drivers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{api_base}}/drivers?per_page=15",
              "host": ["{{api_base}}"],
              "path": ["drivers"],
              "query": [
                { "key": "per_page", "value": "15" },
                { "key": "status", "value": "active", "disabled": true, "description": "active | on_vacation | deactivated" },
                { "key": "search", "value": "ahmed", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Export Drivers (Excel)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base}}/drivers/export?format=xlsx",
              "host": ["{{api_base}}"],
              "path": ["drivers", "export"],
              "query": [{ "key": "format", "value": "xlsx" }]
            }
          }
        },
        {
          "name": "Export Drivers (PDF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base}}/drivers/export?format=pdf",
              "host": ["{{api_base}}"],
              "path": ["drivers", "export"],
              "query": [{ "key": "format", "value": "pdf" }]
            }
          }
        },
        {
          "name": "Create Driver",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "New Driver", "type": "text" },
                { "key": "email", "value": "new.driver+{{$timestamp}}@gcm.test", "type": "text" },
                { "key": "phone", "value": "0100001{{$timestamp}}", "type": "text" },
                { "key": "photo", "type": "file", "src": [], "disabled": true },
                { "key": "password", "value": "Password123!", "type": "text" },
                { "key": "password_confirmation", "value": "Password123!", "type": "text" },
                { "key": "status", "value": "active", "type": "text" },
                { "key": "additional_data", "value": "", "type": "text", "disabled": true },

                { "key": "residence_number", "value": "RES-0001", "type": "text" },
                { "key": "residence_valid_to", "value": "2027-01-01", "type": "text" },
                { "key": "residence_attachment", "type": "file", "src": [], "disabled": true },

                { "key": "license_number", "value": "LIC-0001", "type": "text" },
                { "key": "license_valid_to", "value": "2027-01-01", "type": "text" },
                { "key": "license_attachment", "type": "file", "src": [], "disabled": true },

                { "key": "operational_license_number", "value": "OPL-0001", "type": "text" },
                { "key": "operational_license_valid_to", "value": "2027-01-01", "type": "text" },
                { "key": "operational_license_attachment", "type": "file", "src": [], "disabled": true },

                { "key": "insurance_number", "value": "INS-0001", "type": "text" },
                { "key": "insurance_valid_to", "value": "2027-01-01", "type": "text" },
                { "key": "insurance_attachment", "type": "file", "src": [], "disabled": true },

                { "key": "entry_permits[0][area_name]", "value": "Cairo Zone A", "type": "text", "disabled": true },
                { "key": "entry_permits[0][permit_number]", "value": "PERMIT-0001", "type": "text", "disabled": true },
                { "key": "entry_permits[0][valid_to]", "value": "2027-01-01", "type": "text", "disabled": true },
                { "key": "entry_permits[0][attachment]", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": { "raw": "{{api_base}}/drivers", "host": ["{{api_base}}"], "path": ["drivers"] },
            "description": "Creates the User (role=driver) + Driver profile + any entry permits in one transaction. entry_permits[*] rows are disabled by default — enable them to test that part."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.data && body.data.id) {",
                  "        pm.collectionVariables.set('last_driver_id', body.data.id);",
                  "        console.log('last_driver_id saved:', body.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Show Driver",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{api_base}}/drivers/{{last_driver_id}}",
              "host": ["{{api_base}}"],
              "path": ["drivers", "{{last_driver_id}}"]
            }
          }
        },
        {
          "name": "Update Driver",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Updated Driver Name", "type": "text" },
                { "key": "phone", "value": "0100000000", "type": "text" },
                { "key": "photo", "type": "file", "src": [], "disabled": true },
                { "key": "additional_data", "value": "", "type": "text", "disabled": true },

                { "key": "residence_number", "value": "RES-0001", "type": "text" },
                { "key": "residence_valid_to", "value": "2027-01-01", "type": "text" },
                { "key": "residence_attachment", "type": "file", "src": [], "disabled": true },

                { "key": "license_number", "value": "LIC-0001", "type": "text" },
                { "key": "license_valid_to", "value": "2027-01-01", "type": "text" },
                { "key": "license_attachment", "type": "file", "src": [], "disabled": true },

                { "key": "operational_license_number", "value": "OPL-0001", "type": "text" },
                { "key": "operational_license_valid_to", "value": "2027-01-01", "type": "text" },
                { "key": "operational_license_attachment", "type": "file", "src": [], "disabled": true },

                { "key": "insurance_number", "value": "INS-0001", "type": "text" },
                { "key": "insurance_valid_to", "value": "2027-01-01", "type": "text" },
                { "key": "insurance_attachment", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": {
              "raw": "{{api_base}}/drivers/{{last_driver_id}}",
              "host": ["{{api_base}}"],
              "path": ["drivers", "{{last_driver_id}}"]
            }
          }
        },
        {
          "name": "Add Entry Permit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "area_name", "value": "Cairo Zone A", "type": "text" },
                { "key": "permit_number", "value": "PERMIT-0002", "type": "text" },
                { "key": "valid_to", "value": "2027-01-01", "type": "text" },
                { "key": "attachment", "type": "file", "src": [], "disabled": true }
              ]
            },
            "url": {
              "raw": "{{api_base}}/drivers/{{last_driver_id}}/entry-permits",
              "host": ["{{api_base}}"],
              "path": ["drivers", "{{last_driver_id}}", "entry-permits"]
            }
          }
        },
        {
          "name": "Download Document (Residence)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base}}/drivers/{{last_driver_id}}/documents/residence",
              "host": ["{{api_base}}"],
              "path": ["drivers", "{{last_driver_id}}", "documents", "residence"]
            },
            "description": "type: residence | license | operational-license | insurance. Served from the private `local` disk via a policy-gated route — never a static URL."
          }
        },
        {
          "name": "Download Entry Permit Attachment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_base}}/driver-entry-permits/1/attachment",
              "host": ["{{api_base}}"],
              "path": ["driver-entry-permits", "1", "attachment"]
            },
            "description": "Replace the `1` with a real entry_permits.id (from Show Driver's entry_permits[].id, or the response of Add Entry Permit)."
          }
        }
      ]
    },
    {
      "name": "6. Platform Auth (Super Admin)",
      "item": [
        {
          "name": "Get Login Page (capture CSRF)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/platform/login", "host": ["{{base_url}}"], "path": ["platform", "login"] },
            "description": "Platform is classic session+CSRF Blade auth (guard `platform`), not Bearer — separate from the tenant API entirely. Run this once to seed {{platform_csrf}} and a session cookie in Postman's cookie jar before Login below."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const html = pm.response.text();",
                  "const match = html.match(/name=\"_token\" value=\"([^\"]+)\"/);",
                  "if (match) {",
                  "    pm.collectionVariables.set('platform_csrf', match[1]);",
                  "    console.log('platform_csrf captured');",
                  "} else {",
                  "    console.warn('CSRF token not found on /platform/login — check the login blade still has @csrf');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{platform_csrf}}" },
                { "key": "email", "value": "{{platform_email}}" },
                { "key": "password", "value": "{{platform_password}}" }
              ]
            },
            "url": { "raw": "{{base_url}}/platform/login", "host": ["{{base_url}}"], "path": ["platform", "login"] },
            "description": "On success this redirects (302) to /platform/dashboard and sets the platform session cookie, which Postman's cookie jar then attaches to every request in folders 7-9 automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login accepted (200/302)', () => [200, 302].includes(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [{ "key": "_token", "value": "{{platform_csrf}}" }]
            },
            "url": { "raw": "{{base_url}}/platform/logout", "host": ["{{base_url}}"], "path": ["platform", "logout"] }
          }
        }
      ]
    },
    {
      "name": "7. Platform - Tenants",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "List Tenants",
          "request": {
            "method": "GET",
            "header": [],
