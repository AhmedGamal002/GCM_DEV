APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Riyadh
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# One-time code (OTP) e-mailed before sensitive trip actions — config/otp.php (these are the defaults)
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_AFTER_SECONDS=60
# OTP_VERIFIED_FOR_MINUTES=480
# Minimum gap between two "remind the client" e-mails for the same trip
# TRIP_REMINDER_INTERVAL_MINUTES=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Security (see DEPLOYMENT.md §15) -----------------------------------------------------------------------------
# Outside `local`/tests only APP_URL's host (and its subdomains) is accepted as the Host header; list extra exact hosts
# here (comma separated) — e.g. a tenant served from its own domain.
TRUSTED_HOSTS=
# Requests per minute per signed-in user (exports have their own, lower, ceiling). Raise API_RATE_LIMIT for load tests.
API_RATE_LIMIT=300
EXPORT_RATE_LIMIT=20
# Mobile (bearer) tokens expire after this many minutes (default 30 days).
SANCTUM_TOKEN_EXPIRATION=43200
# Defaults to true when APP_ENV=production; set it explicitly on every HTTPS environment.
# SESSION_SECURE_COOKIE=true
# Vuexy demo pages — local development only. Never registered in production.
SHOW_DEMO_MENU=false
